{
  "name": "bubblyclouds-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:nest": "nest build",
    "build:lambda": "nest build --webpack --webpackPath webpack.config.js",
    "dynamodb:start": "docker run -p 8000:8000 -it --rm instructure/dynamo-local-admin",
    "dynamodb:setup": "ts-node --project tsconfig.spec.json scripts/local-dynamodb-setup.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:local": "npm run build:lambda && npm --prefix ./deploy run cdk:synth && node scripts/sam-local-template.js && AWS_REGION=eu-west-2 AWS_DEFAULT_REGION=eu-west-2 sam local start-api -t ./deploy/cdk.out/ApiStack.template.local.json --env-vars sam-env.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1090.0",
    "@aws-sdk/client-dynamodb": "^3.1090.0",
    "@aws-sdk/lib-dynamodb": "^3.1090.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "aws-lambda": "^1.0.7",
    "aws-xray-sdk": "^3.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exponential-backoff": "^3.1.3",
    "helmet": "^8.3.0",
    "nanoid": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aws-sdk/client-appconfigdata": "^3.1090.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jsonwebtoken": "^9.0.2",
    "prettier": "^3.9.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "\\.module\\.ts$",
      "\\.module-definition\\.ts$",
      "/dto/",
      "/lib/qqwing/",
      "main\\.ts$",
      "lambda\\.ts$",
      "app\\.build\\.ts$"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 85,
        "functions": 95,
        "lines": 95
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^nanoid$": "<rootDir>/../test/mocks/nanoid.ts",
      "^@/(.*)$": "<rootDir>/../src/$1"
    }
  }
}
