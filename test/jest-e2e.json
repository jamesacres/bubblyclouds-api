{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test/e2e"],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.spec.json"
      }
    ]
  },
  "testEnvironment": "node",
  "testTimeout": 60000,
  "moduleNameMapper": {
    "^nanoid$": "<rootDir>/test/mocks/nanoid.ts",
    "^@/lib/qqwing$": "<rootDir>/test/mocks/qqwing.ts",
    "^@/utils/unblock-race-s3-fetcher$": "<rootDir>/test/mocks/unblock-race-s3-fetcher.ts",
    "^@/(.*)$": "<rootDir>/src/$1"
  }
}
