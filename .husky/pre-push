#!/bin/sh
set -e

echo ">>> [root] lint"
npm run lint:check

echo ">>> [root] typecheck"
npm run typecheck

echo ">>> [root] test"
npm test

echo ">>> [dynamodb] start"
docker stop bubblyclouds-api-dynamodb 2>/dev/null || true
docker run --rm -d --name bubblyclouds-api-dynamodb -p 8000:8000 amazon/dynamodb-local:latest
trap 'docker stop bubblyclouds-api-dynamodb 2>/dev/null || true' EXIT INT TERM

echo ">>> [dynamodb] waiting for ready"
i=0
until nc -z localhost 8000 2>/dev/null; do
  i=$((i + 1))
  if [ $i -ge 30 ]; then
    echo "DynamoDB failed to start within 30 seconds" >&2
    exit 1
  fi
  sleep 1
done

echo ">>> [root] integration test"
npm run test:integration

echo ">>> [root] e2e test"
npm run test:e2e

echo ">>> [deploy] build"
npm --prefix ./deploy run build

echo ">>> [deploy] test"
npm --prefix ./deploy test
